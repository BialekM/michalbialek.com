# Kompresja
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml text/plain
</IfModule>

# Pamięć podręczna przeglądarki
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 7 days"
</IfModule>

# Jeden adres strony (https, bez www) – ważne dla SEO. SSL działa dla obu adresów (sprawdzone 13.11.2026).
# Na OVH sprawdzamy port, bo zmienna HTTPS bywa niewiarygodna za ich proxy.
RewriteEngine On
RewriteCond %{SERVER_PORT} ^80$ [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://michalbialek.com%{REQUEST_URI} [L,R=301]
